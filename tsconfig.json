{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": "dist",
    "rootDir": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["./**/*.ts"],
  "exclude": ["dist", "node_modules"]
}


